# Copy to .env and fill real values. NEVER commit the real .env.

# --- Admin seed (used only on first run to create the admin account) ---
ADMIN_USER=admin
ADMIN_PASS=                       # min 10 chars, upper+lower+digit+symbol

# --- Session signing secret: 32+ random chars (server refuses to start without) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# development | production  (production enables secure cookies + HTTPS-only)
NODE_ENV=production

# Force 2FA for admin (default true). Set "false" only for local dev.
ENFORCE_2FA=true

# Public origin for pinned CORS (leave blank for same-origin only)
# PUBLIC_ORIGIN=https://your-domain.com

PORT=3000

# --- Email (optional): receive contact messages by mail ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your-app-password
# MAIL_TO=where-to-receive@example.com

# --- Razorpay (optional): online donations ---
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-key-secret

# --- YouTube API (optional): fetch live comments for testimonials section ---
# Get a key at https://console.cloud.google.com → YouTube Data API v3
# YOUTUBE_API_KEY=AIza...
