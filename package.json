    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "helmet": "^8.2.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.16",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4"
