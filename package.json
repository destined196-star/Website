{
  "name": "devimurlika-site",
  "version": "1.0.0",
  "description": "Devi Murlika Gaur — devotional site with admin panel",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "build": "npm rebuild better-sqlite3 --build-from-source",
    "postinstall": "npm rebuild better-sqlite3 --build-from-source",
